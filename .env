# =============================================================================
# DOCKER / COMPOSE RUNTIME
# =============================================================================
COMPOSE_PROJECT_NAME=global_stack
COMPOSE_REMOVE_ORPHANS=true
COMPOSE_HTTP_TIMEOUT=200
# COMPOSE_FILE: semicolon-separated list of all active service compose files.
# WARNING: a trailing semicolon silently breaks the stack (Docker Compose quirk).
# To review entries: echo "${COMPOSE_FILE}" | tr ';' '\n'
COMPOSE_FILE=docker-compose.yaml;docker/images/00base/docker-compose.yaml;docker/images/00corentinth-it-tools/docker-compose.yaml;docker/images/01axllent-mailpit/docker-compose.yaml;docker/images/01caddy/docker-compose.yaml;docker/images/01epiclabs-docker-oracle-xe-11g/docker-compose.yaml;docker/images/01mariadb12/docker-compose.yaml;docker/images/01mongo8/docker-compose.yaml;docker/images/01mysql9/docker-compose.yaml;docker/images/01postgres18/docker-compose.yaml;docker/images/01redis/docker-compose.yaml;docker/images/01valkey/docker-compose.yaml;docker/images/01selenium-standalone-chrome/docker-compose.yaml;docker/images/01selenium-standalone-firefox/docker-compose.yaml;docker/images/02dpage-pgadmin4/docker-compose.yaml;docker/images/02keycloak-keycloak/docker-compose.yaml;docker/images/02mongoclient-mongoclient/docker-compose.yaml;docker/images/02nvm/docker-compose.yaml;docker/images/02fvm/docker-compose.yaml;docker/images/02phpbrew/docker-compose.yaml;docker/images/02pyenv/docker-compose.yaml;docker/images/02rbenv/docker-compose.yaml;docker/images/02rust/docker-compose.yaml;docker/images/02sdkman/docker-compose.yaml;docker/images/02sonarqube/docker-compose.yaml;docker/images/03flutter3/docker-compose.yaml;docker/images/03java17-zulu/docker-compose.yaml;docker/images/03java21-zulu/docker-compose.yaml;docker/images/03java25-zulu/docker-compose.yaml;docker/images/03node22/docker-compose.yaml;docker/images/03node24/docker-compose.yaml;docker/images/03nodeedge/docker-compose.yaml;docker/images/03php8-2/docker-compose.yaml;docker/images/03php8-3/docker-compose.yaml;docker/images/03php8-4/docker-compose.yaml;docker/images/03php8-5/docker-compose.yaml;docker/images/03phpedge/docker-compose.yaml;docker/images/03python3/docker-compose.yaml;docker/images/03ruby3/docker-compose.yaml;docker/images/03ruby4/docker-compose.yaml;docker/images/04android/docker-compose.yaml;docker/images/04phpmyadmin/docker-compose.yaml;docker/images/04serverless-framework/docker-compose.yaml;docker/images/05stable/docker-compose.yaml;docker/images/05edge/docker-compose.yaml
COMPOSE_PATH_SEPARATOR=;

# Install docker like this sudo apt install docker-ce docker-ce-cli containerd.io from https://docs.docker.com/engine/release-notes/
# For local registry TLS setup, see: templates/tips/docker-local-registry.md
DOCKER_BUILDKIT=1
BUILDX_EXPERIMENTAL=1
COMPOSE_DOCKER_CLI_BUILD=1
COMPOSE_BAKE=true
BUILDKIT_PROGRESS=auto
DOCKER_INIT=true
BUILDX_BAKE_FILE=docker-bake.local.json
COMPOSE_FULL_FILE=docker-compose.full.local.yaml
# =============================================================================
# STACK IDENTITY & GLOBAL DEFAULTS
# =============================================================================
# GitHub API token for env-update API calls (avoids rate limiting). Override in .env.local
GLOBAL_STACK_GITHUB_TOKEN=
# To review COMPOSE_FILE entries: echo "${COMPOSE_FILE}" | tr ';' '\n'
# WARNING: a trailing semicolon in COMPOSE_FILE silently breaks the stack.
GLOBAL_STACK_COMPOSE_CLI=docker compose
GLOBAL_STACK_DOCKER_HOST_DSN=host.docker.internal
GLOBAL_STACK_VERSION=2_0_0_local
# Master user credential — all DB passwords, pgAdmin, Keycloak, Docker default to this value
GLOBAL_STACK_DOCKER_USER_ID=developer
GLOBAL_STACK_DOCKER_USER_EMAIL=
GLOBAL_STACK_DOCKER_USER_NAME=
GLOBAL_STACK_DOCKER_ROOT_PATH=/stack

# GLOBAL_STACK_SHELL_HISTORY needs to be relative path
GLOBAL_STACK_SHELL_HISTORY=docker/config/root/.bash_history
GLOBAL_STACK_SHELL_HISTORY_TARGET=.bash_history
GLOBAL_STACK_SHELL_RC_TARGET=.bashrc
GLOBAL_STACK_SHELL=bash
GLOBAL_STACK_USE_LOCKS=false

# =============================================================================
# PORT BINDING CONVENTION
# All port vars below are intentionally EMPTY in this file — this is the
# machine-neutral master reference. Machine-specific bindings live in .env.local
# using HOST_PORT: format (e.g. GLOBAL_STACK_MYSQL9_PORT_3306=42708:)
# The trailing colon is required — compose uses ${VAR:-}CONTAINER_PORT, so
# the value must include the separator (42708: + 3306 = 42708:3306).
# Port range for this stack: 42700–42811 (avoids system-service conflicts)
# =============================================================================
# =============================================================================
# DATABASE ADMIN UIs
# =============================================================================
# docker/images/02dpage-pgadmin4/dist/entrypoint.sh https://github.com/pgadmin-org/pgadmin4/blob/REL-9_14/pkg/docker/entrypoint.sh
# @todo env-update (override) (tag-filter:^[0-9]+\.[0-9]+\.[0-9]+$) dockerhub:dpage/pgadmin4 9.13.0
GLOBAL_STACK_IMAGE_DPAGE_PGADMIN4_VERSION=9.13.0
GLOBAL_STACK_PGADMIN_DEFAULT_EMAIL=${GLOBAL_STACK_DOCKER_USER_ID}@local.io
GLOBAL_STACK_PGADMIN_DEFAULT_PASSWORD=${GLOBAL_STACK_DOCKER_USER_ID}
GLOBAL_STACK_DPAGE_PGADMIN4_PORT_80=
GLOBAL_STACK_DPAGE_PGADMIN4_PORT_443=
# =============================================================================
# AUTH / IAM
# =============================================================================
# @todo env-update quay:keycloak/keycloak 26.5.5-0
GLOBAL_STACK_IMAGE_KEYCLOAK_KEYCLOAK_VERSION=26.5.5-0
GLOBAL_STACK_KEYCLOAK_ADMIN=${GLOBAL_STACK_DOCKER_USER_ID}
GLOBAL_STACK_KEYCLOAK_ADMIN_PASSWORD=${GLOBAL_STACK_DOCKER_USER_ID}
GLOBAL_STACK_KEYCLOAK_KC_FEATURES=account,account-api,admin,admin-api,admin-fine-grained-authz,authorization,ciba,client-policies,client-secret-rotation,client-types,declarative-ui,device-flow,docker,dpop,dynamic-scopes,impersonation,ipa-tuura-federation,kerberos,login,oid4vc-vci,opentelemetry,organization,par,passkeys,persistent-user-sessions,preview,quick-theme,recovery-codes,rolling-updates,scripts,step-up-authentication,token-exchange,token-exchange-external-internal,token-exchange-standard,transient-users,update-email,user-event-metrics,web-authn
GLOBAL_STACK_KEYCLOAK_KEYCLOAK_HOSTNAME=keycloak-tls-lcl.com
GLOBAL_STACK_KEYCLOAK_KEYCLOAK_PORT_8080=
GLOBAL_STACK_KEYCLOAK_KEYCLOAK_PORT_8443=
GLOBAL_STACK_KEYCLOAK_KEYCLOAK_PORT_9990=
GLOBAL_STACK_KEYCLOAK_KEYCLOAK_PORT_9000=
# @todo GLOBAL_STACK_IMAGE_EPICLABS_DOCKER_ORACLE_XE_11G_VERSION fix latest version
# @todo env-update dockerhub:epiclabs/docker-oracle-xe-11g latest
GLOBAL_STACK_IMAGE_EPICLABS_DOCKER_ORACLE_XE_11G_VERSION=latest
GLOBAL_STACK_EPICLABS_DOCKER_ORACLE_XE_11G_ORACLE_ALLOW_REMOTE=true
GLOBAL_STACK_DATABASE_ROOT_PASSWORD=${GLOBAL_STACK_DOCKER_USER_ID}
GLOBAL_STACK_EPICLABS_DOCKER_ORACLE_XE_11G_RELAX_SECURITY=true
GLOBAL_STACK_EPICLABS_DOCKER_ORACLE_XE_11G_PORT_1521=
GLOBAL_STACK_EPICLABS_DOCKER_ORACLE_XE_11G_PORT_8080=
# =============================================================================
# MAIL & TEST UTILITIES
# =============================================================================
# @todo env-update dockerhub:axllent/mailpit v1.29.3
GLOBAL_STACK_IMAGE_AXLLENT_MAILPIT_VERSION=v1.29.3
GLOBAL_STACK_AXLLENT_MAILPIT_PORT_1025=
GLOBAL_STACK_AXLLENT_MAILPIT_PORT_8025=
GLOBAL_STACK_AXLLENT_MAILPIT_MP_DATABASE=./docker/storage/mailpit
# @todo env-update dockerhub:corentinth/it-tools nightly
GLOBAL_STACK_CORENTINTH_IT_TOOLS_VERSION=nightly
# @todo env-update github:nginx/njs 0.9.6
GLOBAL_STACK_CORENTINTH_IT_TOOLS_NJS_VERSION=0.9.6
GLOBAL_STACK_CORENTINTH_IT_TOOLS_PORT_80=
# =============================================================================
# DATABASES
# =============================================================================
# https://github.com/MariaDB/mariadb-docker/blob/master/12.0/Dockerfile
# docker/images/01mariadb12
# (could have an override)
# @todo env-update (channel:unstable) (tag-filter:noble) dockerhub:_/mariadb:12 12.3.1-noble-rc urls: https://mariadb.com/kb/en/release-notes/
GLOBAL_STACK_IMAGE_MARIADB12_VERSION=12.3.1-noble-rc
GLOBAL_STACK_DATABASE_CHARSET=utf8mb4
# NOTE: Uses variable expansion — intentional. Resolved correctly by Docker Compose and GNU Make.
# Do not read this file with plain dotenv parsers (e.g. in CI scripts) without expanding variables first.
GLOBAL_STACK_DATABASE_COLLATE=${GLOBAL_STACK_DATABASE_CHARSET}_general_ci
GLOBAL_STACK_DATABASE_PASSWORD=${GLOBAL_STACK_DOCKER_USER_ID}
GLOBAL_STACK_DATABASE_USER=${GLOBAL_STACK_DOCKER_USER_ID}
GLOBAL_STACK_MARIADB12_PORT_3306=
GLOBAL_STACK_MARIADB12_DBS=testx
# https://github.com/docker-library/mongo/blob/master/8.0/Dockerfile
# (could have an override)
# @todo env-update (channel:unstable) (tag-filter:noble) dockerhub:_/mongo:8 8.2.6-rc0-noble urls: https://www.mongodb.com/docs/manual/release-notes/8.2/
GLOBAL_STACK_IMAGE_MONGO8_VERSION=8.2.6-rc0-noble
GLOBAL_STACK_MONGO8_PORT_27017=
GLOBAL_STACK_MONGO8_DBS=testx mongoclient_mongoclient
# @todo env-update dockerhub:mongoclient/mongoclient 4.0.1
GLOBAL_STACK_IMAGE_MONGOCLIENT_MONGOCLIENT_VERSION=4.0.1
GLOBAL_STACK_MONGOCLIENT_MONGOCLIENT_DEFAULT_MONGO_URL=mongodb://01mongo8:27017/mongoclient_mongoclient
GLOBAL_STACK_MONGOCLIENT_MONGOCLIENT_PORT_3000=
# docker/images/01mysql9
# (could have an override)
# @todo env-update (tag-filter:oraclelinux) dockerhub:_/mysql:9 9.6.0-oraclelinux9 urls: https://dev.mysql.com/doc/relnotes/mysql/9.6/en/ https://github.com/docker-library/mysql/blob/master/innovation/Dockerfile.oracle
GLOBAL_STACK_IMAGE_MYSQL9_VERSION=9.6.0-oraclelinux9
GLOBAL_STACK_MYSQL9_PORT_3306=
GLOBAL_STACK_MYSQL9_PORT_33060=
GLOBAL_STACK_MYSQL9_DBS=testx
# https://github.com/docker-library/postgres/tree/master/18/alpine3.23
# (could have an override)
# @todo env-update (tag-filter:alpine) dockerhub:_/postgres:18 18.3-alpine3.23 urls: https://www.postgresql.org/docs/release/
GLOBAL_STACK_IMAGE_POSTGRES18_VERSION=18.3-alpine3.23
GLOBAL_STACK_POSTGRES18_PORT_5432=
GLOBAL_STACK_POSTGRES18_DBS=testx sonarqube keycloak
GLOBAL_STACK_POSTGRES18_SHM_SIZE=1gb
# =============================================================================
# PATHS & VOLUME ROOTS
# =============================================================================
GLOBAL_STACK_DOCKER_TOOLS_PATH=${GLOBAL_STACK_DOCKER_ROOT_PATH}/tools
# @todo env-update (tag-extract:-grid-([0-9\.\-]+)$) dockerhub:selenium/standalone-chrome 4.41.0-20260222
GLOBAL_STACK_IMAGE_SELENIUM_STANDALONE_CHROME_VERSION=4.41.0-20260222
# =============================================================================
# RELOAD SWITCHES — set true to force full reinstall on next container start
# SLOW: full reinstall can take 10-30+ minutes. Reset to false after use.
# =============================================================================
GLOBAL_STACK_RELOAD_ALL=false
GLOBAL_STACK_RELOAD_PERMISSIONS=false
GLOBAL_STACK_RELOAD_NVM=false
GLOBAL_STACK_RELOAD_PHPBREW=false
GLOBAL_STACK_RELOAD_PHP8_2=false
GLOBAL_STACK_RELOAD_PHP8_3=false
GLOBAL_STACK_RELOAD_PHP8_4=false
GLOBAL_STACK_RELOAD_PHP8_5=false
GLOBAL_STACK_RELOAD_PHPEDGE=false
GLOBAL_STACK_RELOAD_PHPMYADMIN=false
GLOBAL_STACK_RELOAD_SDKMAN=false
GLOBAL_STACK_RELOAD_RUST=false
GLOBAL_STACK_RELOAD_PYENV=false
GLOBAL_STACK_RELOAD_RUBY=false
GLOBAL_STACK_RELOAD_FVM=false
GLOBAL_STACK_RELOAD_FLUTTER3=false
GLOBAL_STACK_RELOAD_ANDROID=false
GLOBAL_STACK_RELOAD_HTTPD=false
GLOBAL_STACK_RELOAD_HTTP_COMMON=false
GLOBAL_STACK_RELOAD_NGINX=false
GLOBAL_STACK_RELOAD_CADDY=false

# or host-gateway or custom host-gateway like 172.18.0.1 if you want to point to docker0 interface or an ip address
GLOBAL_STACK_HOST_GATEWAY_IP=172.18.0.1
GLOBAL_STACK_HOST_GATEWAY_IP_MASK=172.18.0.0/16
# GLOBAL_STACK_EXPOSED_VIRTUAL_HOSTS example xxx.dev.local dev.xxx.local
GLOBAL_STACK_EXPOSED_VIRTUAL_HOSTS=stack.local
GLOBAL_STACK_SELENIUM_STANDALONE_CHROME_PORT_4444=
GLOBAL_STACK_SELENIUM_STANDALONE_CHROME_PORT_5900=
GLOBAL_STACK_DOCKER_WORKDIR=${GLOBAL_STACK_DOCKER_ROOT_PATH}/projects
# used as CAROOT
GLOBAL_STACK_CAROOT=${GLOBAL_STACK_DOCKER_TOOLS_PATH}/caroot
GLOBAL_STACK_SSL_PATH=${GLOBAL_STACK_DOCKER_TOOLS_PATH}/ssl
GLOBAL_STACK_DOCKER_TOOLS_PATH_SUCCESSES=${GLOBAL_STACK_DOCKER_TOOLS_PATH}/successes
GLOBAL_STACK_DOCKER_TOOLS_PATH_ERRORS=${GLOBAL_STACK_DOCKER_TOOLS_PATH}/errors
