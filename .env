COMPOSE_PATH_SEPARATOR=;

# Install docker like this sudo apt install docker-ce docker-ce-cli containerd.io from https://docs.docker.com/engine/release-notes/
# @ŧodo look at templates/tips/docker-local-registry.md
DOCKER_BUILDKIT=1
BUILDX_EXPERIMENTAL=1
COMPOSE_DOCKER_CLI_BUILD=1
COMPOSE_BAKE=true
#--debug --log-level DEBUG
GLOBAL_STACK_COMPOSE_CLI=docker compose
GLOBAL_STACK_DOCKER_HOST_DSN=host.docker.internal
# @todo change ARG GLOBAL_STACK_VERSION=1_5_0_local everywhere
GLOBAL_STACK_VERSION=1_5_0_local
GLOBAL_STACK_DOCKER_ROOT_PATH=/stack

# GLOBAL_STACK_SHELL_HISTORY needs to be relative path
GLOBAL_STACK_SHELL_HISTORY=docker/config/root/.bash_history
GLOBAL_STACK_SHELL_HISTORY_TARGET=.bash_history
GLOBAL_STACK_SHELL_RC_TARGET=.bashrc
GLOBAL_STACK_SHELL=bash
GLOBAL_STACK_USE_LOCKS=false
