{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(bin/env-scan.sh:*)",
      "Bash(bin/env-update.sh:*)",
      "Bash(bin/check-image-versions.sh:*)",
      "Bash(bin/tests/:*)",
      "Bash(bin/:*)",
      "Bash(scripts/:*)",
      "Bash(bash bin/:*)",
      "Bash(bash scripts/:*)",
      "Bash(shellcheck:*)",
      "Bash(hadolint:*)",
      "Bash(yamllint:*)",
      "Bash(shfmt:*)",
      "Bash(yamlfmt:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(tree:*)",
      "Bash(xargs:*)",
      "Bash(realpath:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",
      "Bash(printf:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(ln:*)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(tar:*)",
      "Bash(gzip:*)",
      "Bash(curl:*)",
      "Bash(env:*)",
      "Bash(timeout:*)",
      "Bash(nproc:*)",
      "Bash(uname:*)",
      "Bash(command:*)",
      "Bash(which:*)",
      "Bash(compgen:*)",
      "Bash(bash:*)",
      "Bash(python3:*)",
      "Bash(perl:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__github"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shellcheck-on-write.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hadolint-on-write.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/yamllint-on-write.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shfmt-on-write.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/env-guard-on-write.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
